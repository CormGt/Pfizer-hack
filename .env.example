# Copy this file to a new file called .env and fill it in.

# Which AI to use:
#   ollama  = a free model running on your own computer (default, no key needed)
#   claude  = Claude via the Anthropic API (needs ANTHROPIC_API_KEY below)
AI_PROVIDER=ollama

# --- Ollama settings (only used when AI_PROVIDER=ollama) ---
# The model must be able to read images. Download it first with:  ollama pull qwen2.5vl:7b
OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_URL=http://localhost:11434

# --- Claude settings (only used when AI_PROVIDER=claude) ---
# Get a key at https://console.anthropic.com/settings/keys  (no quotes, no spaces)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional: set to 1 to click around with example results and no AI at all.
# DEMO_MODE=1
