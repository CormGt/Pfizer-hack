# Copy this file to a new file called .env and change anything you need.

# The local AI model (it must be able to read images). Download it first with:
#   ollama pull qwen2.5vl:7b
# On a Mac with 8 GB of memory, use qwen2.5vl:3b instead.
OLLAMA_MODEL=qwen2.5vl:7b

# Where Ollama runs. It must be this computer: the app refuses anything else.
# OLLAMA_URL=http://localhost:11434

# The folders of notes the assistant may look at, separated by commas.
# Leave it empty to use the made-up sample notes that come with the app.
# NOTES_FOLDERS=~/Documents/Meeting notes,~/Desktop/Screenshots

# Optional: set to 1 to click around with example results and no AI at all.
# DEMO_MODE=1

# Optional: set to 1 to let your phone (on the same Wi-Fi) open the app.
# Off by default so nothing on your network can reach your notes.
# PHONE_ACCESS=1
